# =========================================================================
# 账单中心 (Bill Center) 环境变量配置示例文件 (.env.example)
# =========================================================================
# 使用方法:
# 1. 复制本文件并重命名为 `.env`: cp .env.example .env
# 2. 根据实际部署环境修改以下配置项的值
# =========================================================================

# -------------------------------------------------------------------------
# 1. 数据库基础参数 (由开发环境和 Docker 共用)
# -------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres_secure_pwd
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bill_center

# -------------------------------------------------------------------------
# 2. 数据库连接串 (Prisma 使用)
# -------------------------------------------------------------------------
# 本地开发直连数据库地址 (使用上面的变量进行动态展开，避免重复配置密码和库名)
# Next.js 启动时会自动解析这里的 ${变量名}
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"


# -------------------------------------------------------------------------
# 3. 端口配置 (用于 Docker-Compose 映射)
# -------------------------------------------------------------------------
# 宿主机上可访问的应用端口 (例如浏览器访问 http://localhost:3000)
HOST_PORT=3000

# 宿主机上可访问的数据库端口 (用于使用客户端直连或在宿主机本地执行 prisma 命令)
HOST_DB_PORT=5432

# 容器内部监听的端口 (Next.js 运行端口)
PORT=3000


# -------------------------------------------------------------------------
# 4. AI 智能分类/识别服务配置 (以 OpenAI 或兼容的 API 格式为准)
# -------------------------------------------------------------------------
# OpenAI API 密钥 (请替换为您自己的有效 Key)
OPENAI_API_KEY="your-api-key-here"

# AI 服务接口基础地址
# 默认使用 LongCat AI 服务，如果使用官方 OpenAI 请配置为 "https://api.openai.com/v1"
OPENAI_BASE_URL="https://api.longcat.chat/openai"

# 调用的 AI 模型名称
OPENAI_MODEL="LongCat-2.0-Preview"
